# Copie este arquivo para .env.producao.local na raiz e informe os valores
# reais somente na máquina local. O arquivo local é ignorado pelo Git.
POSTGRES_DB=Labvet V1
POSTGRES_USER=labvet_app
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

LABVET_API_PORT=9010
LABVET_JWT_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
LABVET_JWT_ISSUER=labvet-api-producao
LABVET_JWT_AUDIENCE=labvet-web-producao
LABVET_REFRESH_COOKIE_NAME=labvetRefreshProducao
